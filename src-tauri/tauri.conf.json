{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoSubs Refresh",
  "version": "0.1.0",
  "identifier": "com.yourname.autosubsrefresh",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AutoSubs Refresh",
        "width": 420,
        "height": 320,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../resolve-bridge/RefreshCaptionsWatcher.lua": "resolve-bridge/RefreshCaptionsWatcher.lua"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
